{
  "manifest_version": 3,
  "name": "Tailwind Grid Overlay",
  "version": "1.0.0",
  "description": "Toggle a Tailwind-style 12-column grid and 4/16 px baseline overlay on the current page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Tailwind Grid Overlay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
